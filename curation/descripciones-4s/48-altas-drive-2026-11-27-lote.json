  "bandit": {
   "que_es": "Analizador de seguridad para código Python mantenido por la comunidad PyCQA.",
   "que_hace": "Detecta patrones de riesgo como comandos con shell, deserialización insegura, contraseñas escritas en el código o criptografía débil.",
   "como_lo_hace": "Recorre el árbol de sintaxis de cada archivo con complementos identificados por códigos (B101, B602, B506…) y clasifica cada hallazgo por gravedad y confianza.",
   "combina_con": [
    {
     "id": "pre-commit",
     "motivo": "Ejecuta Bandit antes de cada commit con el gancho que publica el propio repositorio."
    },
    {
     "id": "gitleaks",
     "motivo": "Busca claves y contraseñas filtradas en todo el historial de git, que Bandit no revisa."
    },
    {
     "id": "defectdojo",
     "motivo": "Importa los informes de Bandit para seguir y deduplicar hallazgos junto con los de otros escáneres."
    }
   ],
